# Never commit credentials or machine state
.credentials.json
settings.local.json
.mcp.json
*.local.json

# Never commit user data. It belongs in ~/.claude/daikenja/, not in the plugin.
daikenja.yaml
personas.md
profile.md
writing-style.md
.daikenja/

# ...except the blank starting points the plugin ships.
!templates/**

# Claude Code generated state, if the repo ever sits inside ~/.claude
history/
projects/
todos/
statsig/
shell-snapshots/
sessions/
MEMORY.md
memory/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Superpowers plugin scratch: staged-rollout working state and its own
# plans/specs drafts. Local-to-the-run by design -- durable output belongs in
# docs/architecture or docs/runbooks, not here. .superpowers/ self-ignores via
# its own nested .gitignore; this stops docs/superpowers/ from being committed.
.superpowers/
docs/superpowers/
