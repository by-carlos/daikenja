# Daikenja bot configuration.
#
# Copy this to ~/.claude/daikenja/bot.yaml and edit it. Never commit the
# copy: it names your workspace and may hold your tokens.
#
# Check it with:  python -m daikenja_bot --check

slack:
  # Your own Slack user ID -- click your name in Slack, then "Copy member ID".
  # Required. Only this person can trigger the bot unless allowed_users
  # widens it, and the owner is always allowed.
  owner_user_id: U0EXAMPLEOWNER

  # Optional. Other people who may trigger it.
  allowed_users: []

  # Optional. Restrict it to named channels. Empty means every channel the
  # bot has been invited to.
  allowed_channels: []

  # Where the tokens come from. The environment is the default and the
  # recommendation; a *_token_file is the alternative for a 0600 file.
  bot_token_env: SLACK_BOT_TOKEN
  app_token_env: SLACK_APP_TOKEN
  # bot_token_file: ~/.claude/daikenja/slack-bot-token
  # app_token_file: ~/.claude/daikenja/slack-app-token

  # Emoji added to the mention while the answer is being written. Needs the
  # reactions:write scope; set it to null to skip the reaction entirely. Also
  # doubles as the re-fire guard for reaction_trigger below.
  ack_reaction: eyes

  # Optional. An emoji name (no colons) that, when an allowed person reacts
  # with it on any message, runs summary + judgement on that message's
  # thread and posts one combined reply -- no @-mention needed. The emoji
  # has to exist in your workspace first (a workspace admin creates custom
  # ones), and the app needs the reactions:read scope and the
  # reaction_added event subscription. Unset means this is off.
  # reaction_trigger: daikenja

  # What someone who is not on the allowlist is told. It goes out as an
  # ephemeral message -- only they see it, nobody is notified, and nothing is
  # left in the channel. `{owner}` becomes a mention of owner_user_id.
  # Set it to null to say nothing at all.
  # unauthorized_message: >-
  #   Sorry, this bot is in beta and runs on {owner}'s own account.

claude:
  # The Claude Code CLI. A full path works if it is not on PATH.
  command: claude

  # The model and effort level the headless session runs on. These are the
  # defaults and can be left as they are; reading a thread and writing a few
  # lines to a fixed format does not need a larger model, and every mention
  # pays for it. Set either one to an empty value to follow whatever your
  # account's default is instead. Effort is separate from the model name --
  # `claude-sonnet-5-medium` is not a model.
  model: claude-sonnet-5
  effort: medium   # low, medium, high, xhigh, max

  # Optional. Only for running against a working tree of this repository;
  # an installed plugin needs nothing here.
  # plugin_dir: C:/GitHub/daikenja

  # Where the headless session runs. Defaults to your home directory, which
  # is deliberate: a bot has no project of its own, so threads should be
  # matched to a project by their content rather than by whatever directory
  # the process happens to sit in.
  # working_dir: ~

  # The tools the headless session may use. Read-only by default. Adding
  # Bash or Write here hands a tool to a session that is reading text other
  # people wrote -- do not.
  allowed_tools:
    - Read
    - Glob
    - Grep

  # Extra arguments passed to `claude`, if you need any.
  extra_args: []

  # How long one answer may take before it is abandoned.
  timeout_seconds: 300

# Optional. Without this block, a Confluence or Jira link gets a one-line
# reply saying it is not configured, and nothing else happens. The one block
# turns on both products: on Atlassian Cloud they share a site and a token.
# confluence:
#   base_url: https://example.atlassian.net
#   email: you@example.com
#   token_env: CONFLUENCE_API_TOKEN
